{
  "name": "prompt-benchmark-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check src e2e",
    "format": "biome check --write src e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node ./scripts/prepare-e2e.mjs && playwright test",
    "e2e:only": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.104.1",
    "@vue/devtools-api": "8.2.1",
    "element-plus": "2.14.7",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.14",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  }
}
