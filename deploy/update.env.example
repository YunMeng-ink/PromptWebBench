# deploy/update.sh 的配置模板。复制到 /etc/prompt-benchmark/update.env 后按需修改，
# 并执行 sudo chmod 600 /etc/prompt-benchmark/update.env。
#
# 已经存在的环境变量优先于本文件，因此可以临时用 TAG=v0.4.0 deploy/update.sh 覆盖。

# GitHub 仓库与发布资产名
REPO=YunMeng-ink/PromptWebBench
ASSET=prompt-benchmark

# 安装目录：二进制写到 $INSTALL_DIR/dist/$ASSET
INSTALL_DIR=/opt/prompt-benchmark

# 重启方式：systemd 调用 systemctl restart；script 调用 deploy/pb.sh restart
RESTART_MODE=systemd
SERVICE=prompt-benchmark
# 仅 RESTART_MODE=script 时使用
ENV_FILE=/etc/prompt-benchmark/env

# 重启后的健康检查地址
HEALTH_URL=http://127.0.0.1:8080/api/v1/health

# 已安装版本与更新锁的存放目录
STATE_DIR=/var/lib/prompt-benchmark
