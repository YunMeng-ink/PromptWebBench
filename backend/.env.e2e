# 端到端测试使用的后端配置。仅用于本机 e2e，密钥不具备任何生产价值。
PORT=8080
LOG_LEVEL=warn

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=prompt_benchmark_e2e
DB_USER=postgres
DB_SSLMODE=disable

JWT_SECRET=e2e0123456789abcdefe2e0123456789abcdefe2e0123456789abcdef
ADMIN_INIT_PASSWORD=E2eAdminPassw0rd!
ADMIN_INIT_EMAIL=e2e-admin@prompt-benchmark.local

# 指向本地 SMTP 接收器（cmd/smtpsink），测试从中读取验证码。
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_FROM=noreply@prompt-benchmark.local

PUBLIC_BASE_URL=http://127.0.0.1:4173
CORS_ALLOW_ORIGINS=http://127.0.0.1:4173
COOKIE_SECURE=false

# 端到端用例从同一地址连续走各类接口，放宽限流以免用例之间互相干扰。
RATE_LIMIT=2000
