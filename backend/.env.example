# Prompt Benchmark 后端环境变量示例（开发方案 §8.2）
# 复制为 .env.local 后填入本机取值；.env.local 已被 gitignore，不进入版本库。

# 服务
PORT=8080
LOG_LEVEL=info

# 数据库
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=prompt_benchmark
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# 密钥：JWT_SECRET 必须为至少 32 字节；CONFIG_SECRET 缺省时禁止保存密钥类配置
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CONFIG_SECRET=

# 初始管理员：ADMIN_INIT_PASSWORD 留空则跳过创建
ADMIN_INIT_PASSWORD=
ADMIN_INIT_EMAIL=admin@prompt-benchmark.local

# 邮件（亦可后续写入 config 表，库内配置优先）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# GitHub OAuth：未配置时 OAuth 接口返回 503
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 中间件
TRUSTED_PROXIES=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# 静态资源（生产由 Nginx 托管时可留空）
STATIC_DIR=
