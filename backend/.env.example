# Prompt Benchmark 后端环境变量示例（开发方案 §8.2）
# 复制为 .env.local 后填入本机取值；.env.local 已被 gitignore，不进入版本库。

# 服务
PORT=8080
LOG_LEVEL=info

# 数据库
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=prompt_benchmark
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable

# 密钥：JWT_SECRET 必须为至少 32 字节，务必用 openssl rand -hex 32 生成独立取值
# （留空会启动失败；不要使用任何公开示例值）
JWT_SECRET=
CONFIG_SECRET=

# 初始管理员：ADMIN_INIT_PASSWORD 留空则跳过创建
ADMIN_INIT_PASSWORD=
ADMIN_INIT_EMAIL=admin@prompt-benchmark.local

# 邮件（亦可后续写入 config 表，库内配置优先）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# GitHub OAuth：未配置时 OAuth 接口返回 503
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 中间件
TRUSTED_PROXIES=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# 认证类接口每分钟限额（按来源地址）。留空使用规格默认值 10。
AUTH_RATE_LIMIT=

# 本服务对外可访问的基地址：用于拼接 GitHub OAuth 回调地址与登录后落地页。
# 前端经反向代理访问后端时填写前端同源地址。
PUBLIC_BASE_URL=http://localhost:5173

# 前端静态资源目录。留空时服务编译期内嵌的前端构建产物（需先执行 deploy/pb.sh build
# 打包；本地 go run 未打包时不服务静态，前端由 Vite 开发服务器承担）；
# 设置时改为服务该磁盘目录（如 ../frontend/dist）。
STATIC_DIR=
